# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Any provider whose key is missing is simply skipped; you can benchmark one
# provider on its own.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: which model grades the responses (a registry key from providers.py).
# Leave blank to auto-pick — Claude Haiku 4.5 if ANTHROPIC_API_KEY is set,
# otherwise GPT-4o mini. With no key at all, the heuristic scorer runs instead.
JUDGE_MODEL=

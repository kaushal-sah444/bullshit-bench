# Copy to .env and fill in what you have. .env is gitignored — never commit real
# keys. Every key is optional: models whose key is missing are simply skipped,
# so you can benchmark one provider, or none at all.

# --- Free: no key required ---------------------------------------------------
# Local servers need nothing here. Install Ollama, `ollama pull llama3.2`, then:
#   python run_bench.py --models ollama:llama3.2 ollama:qwen2.5
# Only set these if your server is not on its default host/port.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# VLLM_BASE_URL=http://localhost:8000/v1
# LLAMACPP_BASE_URL=http://localhost:8080/v1

# --- Free tiers (key required, no charge) ------------------------------------
# OpenRouter hosts many `:free` models:  --models openrouter:<model>:free
OPENROUTER_API_KEY=
# Groq's free tier is fast:              --models groq:<model>
GROQ_API_KEY=

# --- Paid ---------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Other OpenAI-compatible platforms, used as --models <platform>:<model>
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# Any other OpenAI-compatible endpoint:  --models custom:<model>
# CUSTOM_BASE_URL=https://my-gateway.example.com/v1
# CUSTOM_API_KEY=

# --- Judge --------------------------------------------------------------------
# Which model grades the responses: a registry key or a platform reference.
# Leave blank to auto-pick, in this order:
#   Claude Haiku 4.5 -> GPT-4o mini -> Groq free tier -> local Ollama -> heuristic.
# So a local server is enough for a real LLM judge at zero cost.
JUDGE_MODEL=
